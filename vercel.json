{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/next-match.ts": {
      "maxDuration": 15
    },
    "api/club-tools.ts": {
      "maxDuration": 60,
      "includeFiles": "assets/social-video/**"
    }
  },
  "crons": [
    {
      "path": "/api/next-match?view=program",
      "schedule": "0 5 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/programma",
      "destination": "/programma.html"
    },
    {
      "source": "/club",
      "destination": "/api/club"
    },
    {
      "source": "/api/motm",
      "destination": "/api/motm-public?action=index"
    },
    {
      "source": "/api/motm/index",
      "destination": "/api/motm-public?action=index"
    },
    {
      "source": "/api/motm/vote",
      "destination": "/api/motm-public?action=vote"
    },
    {
      "source": "/api/motm/stand",
      "destination": "/api/motm-public?action=stand"
    },
    {
      "source": "/api/motm/share",
      "destination": "/api/motm-public?action=share"
    },
    {
      "source": "/api/players",
      "destination": "/api/motm-public?action=players"
    },
    {
      "source": "/api/motm/manage",
      "destination": "/api/motm-manage"
    },
    {
      "source": "/club/motm",
      "destination": "/api/motm-public?action=index"
    },
    {
      "source": "/club/tools",
      "destination": "/api/club-tools"
    },
    {
      "source": "/club/tools/socials",
      "destination": "/api/club-tools?view=socials"
    },
    {
      "source": "/club/tools/jeugddossiers",
      "destination": "/api/jeugddossiers-manage"
    },
    {
      "source": "/club/jeugddossiers/speler/:id",
      "destination": "/api/jeugddossiers?id=:id"
    },
    {
      "source": "/club/jeugddossiers",
      "destination": "/api/jeugddossiers"
    },
    {
      "source": "/club/stand",
      "destination": "/api/motm-public?action=stand"
    },
    {
      "source": "/club/stemmen/:slug",
      "destination": "/api/motm-public?action=vote&slug=:slug"
    },
    {
      "source": "/stem/:slug",
      "destination": "/api/motm-public?action=share&slug=:slug"
    },
    {
      "source": "/club/motm/beheer",
      "destination": "/api/motm-manage?view=list"
    },
    {
      "source": "/club/motm/nieuw",
      "destination": "/api/motm-manage?view=new"
    },
    {
      "source": "/club/motm/beheer/:id",
      "destination": "/api/motm-manage?view=detail&id=:id"
    },
    {
      "source": "/club/motm/beheer/:id/live",
      "destination": "/api/motm-manage?view=live&id=:id"
    },
    {
      "source": "/geen-toegang",
      "destination": "/geen-toegang.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/players/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
