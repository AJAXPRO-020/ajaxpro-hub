{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-public.mjs",
  "outputDirectory": "dist-public",
  "functions": {
    "api/shirt-battle.mjs": {
      "includeFiles": "{assets/shirt-battle/cutouts/**,assets/ajax-shirts/shirts.json,ajaxpro-logo.png,ajaxpro-refrigerator-heavy.otf}"
    },
    "api/club-portal.ts": {
      "includeFiles": "index.html"
    },
    "api/next-match.ts": {
      "maxDuration": 60
    },
    "api/club-tools.ts": {
      "maxDuration": 60,
      "includeFiles": "assets/social-video/**"
    },
    "api/socials-card-video.ts": {
      "maxDuration": 300,
      "includeFiles": "{node_modules/ffmpeg-static/ffmpeg,assets/social-video/card-video-end.png}"
    }
  },
  "crons": [
    {
      "path": "/api/next-match?view=program",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/next-match?view=content-hub-cleanup",
      "schedule": "17 4 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/shirt-battle/r/:token",
      "destination": "/shirts/r/:token",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/shirts",
      "has": [{"type": "query", "key": "result", "value": "(?<token>v1\\.[0-9a-z]+)"}],
      "destination": "/api/shirt-battle?legacy=1&token=:token"
    },
    {
      "source": "/shirts",
      "destination": "/assets/shirt-battle/index.html"
    },
    {
      "source": "/shirts/r/:token",
      "destination": "/api/shirt-battle?token=:token&view=game"
    },
    {
      "source": "/shirts/(.*)",
      "destination": "/assets/shirt-battle/$1"
    },
    {
      "source": "/shirt-battle/r/:token",
      "destination": "/api/shirt-battle?token=:token"
    },
    {
      "source": "/api/shirt-battle/share/:token",
      "destination": "/api/shirt-battle?token=:token"
    },
    {
      "source": "/api/home",
      "destination": "/api/club-portal?portalHandler=home"
    },
    {
      "source": "/api/auth/session-status",
      "destination": "/api/club-portal?portalHandler=session-status"
    },
    {
      "source": "/api/navigation-status",
      "destination": "/api/club-portal?portalHandler=session-status&view=legacy-navigation"
    },
    {
      "source": "/api/press-conferences",
      "destination": "/api/club-tools?view=press-conferences"
    },
    {
      "source": "/programma",
      "destination": "/programma.html"
    },
    {
      "source": "/privacybeleid",
      "destination": "/privacybeleid.html"
    },
    {
      "source": "/club",
      "destination": "/api/club-portal"
    },
    {
      "source": "/club/members",
      "destination": "/api/club-portal?view=members"
    },
    {
      "source": "/club/members/contracten",
      "destination": "/api/club-portal?view=contracts"
    },
    {
      "source": "/club/members/match-center",
      "destination": "/api/club-portal?view=members-match-center"
    },
    {
      "source": "/api/motm",
      "destination": "/api/motm-public?action=index"
    },
    {
      "source": "/api/motm/index",
      "destination": "/api/motm-public?action=index"
    },
    {
      "source": "/api/motm/vote",
      "destination": "/api/motm-public?action=vote"
    },
    {
      "source": "/api/motm/stand",
      "destination": "/api/motm-public?action=stand"
    },
    {
      "source": "/api/motm/share",
      "destination": "/api/motm-public?action=share"
    },
    {
      "source": "/api/players",
      "destination": "/api/motm-public?action=players"
    },
    {
      "source": "/api/motm/manage",
      "destination": "/api/motm-manage"
    },
    {
      "source": "/club/motm",
      "destination": "/api/motm-public?action=index"
    },
    {
      "source": "/club/tools",
      "destination": "/api/club-tools"
    },
    {
      "source": "/club/tools/player-registry",
      "destination": "/api/club-tools?view=player-registry"
    },
    {
      "source": "/club/tools/socials",
      "destination": "/api/club-tools?view=socials"
    },
    {
      "source": "/club/tools/socials-v2",
      "destination": "/api/club-tools?view=socials-v2"
    },
    {
      "source": "/club/tools/content-hub",
      "destination": "/api/club-tools?view=content-hub"
    },
    {
      "source": "/club/tools/jeugddossiers",
      "destination": "/api/jeugddossiers?view=manage"
    },
    {
      "source": "/club/jeugddossiers/speler/:id",
      "destination": "/api/jeugddossiers?id=:id"
    },
    {
      "source": "/club/jeugddossiers",
      "destination": "/api/jeugddossiers"
    },
    {
      "source": "/club/stand",
      "destination": "/api/motm-public?action=stand"
    },
    {
      "source": "/club/stemmen/:slug",
      "destination": "/api/motm-public?action=vote&slug=:slug"
    },
    {
      "source": "/stem/:slug",
      "destination": "/api/motm-public?action=share&slug=:slug"
    },
    {
      "source": "/club/motm/beheer",
      "destination": "/api/motm-manage?view=list"
    },
    {
      "source": "/club/motm/nieuw",
      "destination": "/api/motm-manage?view=new"
    },
    {
      "source": "/club/motm/beheer/:id",
      "destination": "/api/motm-manage?view=detail&id=:id"
    },
    {
      "source": "/club/motm/beheer/:id/live",
      "destination": "/api/motm-manage?view=live&id=:id"
    },
    {
      "source": "/geen-toegang",
      "destination": "/geen-toegang.html"
    },
    {
      "source": "/voorwaarden",
      "destination": "/voorwaarden.html"
    }
  ],
  "headers": [
    {
      "source": "/shirts(.*)",
      "headers": [
        {"key": "X-Robots-Tag", "value": "noindex, nofollow"},
        {"key": "Content-Security-Policy", "value": "default-src 'none'; base-uri 'none'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; form-action 'self'"}
      ]
    },
    {
      "source": "/assets/players/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/assets/social-video/storyboard-frame.html",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
